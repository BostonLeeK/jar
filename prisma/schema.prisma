generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String
  slug         String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monoTokenEnc   String?
  monoJarId      String?
  monoSendId     String?
  monoJarTitle   String?
  monoJarBalance Int     @default(0)
  monoJarGoal    Int     @default(0)
  monoWebhookSet Boolean @default(false)

  twitchId          String?
  twitchLogin       String?
  twitchDisplayName String?
  twitchAvatar      String?
  twitchAccessEnc   String?
  twitchRefreshEnc  String?
  twitchEventSub    Boolean @default(false)
  avatarUrl         String?
  pageCoverUrl      String?
  socialTwitch      String  @default("")
  socialYoutube     String  @default("")
  socialDiscord     String  @default("")
  socialInstagram   String  @default("")
  socialTiktok      String  @default("")
  socialX           String  @default("")

  pageTitle       String  @default("")
  pageBio         String  @default("")
  pageTheme       String  @default("midnight")
  accentColor     String  @default("#ffffff")
  background      String  @default("#000000")
  showGoal        Boolean @default(true)
  goalAmount      Int     @default(0)
  minAmount       Int     @default(1000)
  overlayToken      String  @unique @default(cuid())
  webhookToken      String  @unique @default(cuid())
  overlayTone       String  @default("dark")
  overlayAccent     String  @default("#ffffff")
  overlayDuration   Int     @default(8)
  alertStyle        String  @default("minimal")
  alertShowMessage  Boolean @default(true)
  goalStyle         String  @default("minimal")
  goalShowTitle     Boolean @default(true)
  recentStyle       String  @default("minimal")
  recentLimit       Int     @default(5)
  recentTitle       String  @default("Останні донати")
  alertTts          Boolean @default(false)
  ttsLang           String  @default("uk")
  pageViews         Int     @default(0)
  pageUseCustom     Boolean @default(false)
  pageCustomHtml    String  @default("")
  pageCustomCss     String  @default("")
  alertUseCustom    Boolean @default(false)
  alertCustomHtml   String  @default("")
  alertCustomCss    String  @default("")
  goalUseCustom     Boolean @default(false)
  goalCustomHtml    String  @default("")
  goalCustomCss     String  @default("")
  recentUseCustom   Boolean @default(false)
  recentCustomHtml  String  @default("")
  recentCustomCss   String  @default("")

  donations    Donation[]
  pending      PendingDonation[]
  alertTiers   AlertTier[]
  twitchAlerts TwitchAlert[]
}

model Donation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monoTxId  String
  amount    Int
  nickname  String
  message   String
  createdAt DateTime @default(now())

  @@unique([userId, monoTxId])
  @@index([userId, createdAt])
}

model AlertTier {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAmount Int
  gifUrl    String?
  audioUrl  String?
  tts       Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, minAmount])
}

model TwitchAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  gifUrl    String?
  audioUrl  String?
  tts       Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, kind])
}

model PendingDonation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  nickname  String
  message   String
  code      String
  matched   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, matched, amount])
  @@index([userId, code])
}
